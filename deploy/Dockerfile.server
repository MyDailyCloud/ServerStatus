# Data Server Dockerfile
FROM golang:latest AS builder

WORKDIR /build

# 复制go模块文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY data-server/ ./data-server/

# 构建
WORKDIR /build/data-server
RUN CGO_ENABLED=0 GOOS=linux go build -o data-server main.go

# 运行阶段
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /build/data-server/data-server .
COPY --from=builder /build/data-server/API.md ./API.md
COPY --from=builder /build/data-server/web-ui ./web-ui

# 创建配置文件
RUN echo '{\n\
  "project_key": "test",\n\
  "server_key": "test-secret",\n\
  "host": "0.0.0.0",\n\
  "port": "8080",\n\
  "require_auth": true,\n\
  "data_limit": 1000,\n\
  "data_interval": 5\n\
}' > server-config.json

EXPOSE 8080

CMD ["./data-server", "-config", "server-config.json"]