# Monitor Agent Dockerfile
FROM golang:latest AS builder

WORKDIR /build

# 复制go模块文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY monitor-agent/ ./monitor-agent/

# 构建
WORKDIR /build/monitor-agent
RUN CGO_ENABLED=0 GOOS=linux go build -o monitor-agent main.go

# 运行阶段
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y ca-certificates procps && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /build/monitor-agent/monitor-agent .

# 创建启动脚本
RUN echo '#!/bin/sh\n\
echo "Starting monitor agent..."\n\
echo "Server URL: ${SERVER_URL}"\n\
echo "Project Key: ${PROJECT_KEY}"\n\
echo "Enable User Resources: ${ENABLE_USER_RESOURCES:-true}"\n\
\n\
./monitor-agent \\\n\
  -url "${SERVER_URL}" \\\n\
  -key "${PROJECT_KEY}" \\\n\
  -server-key "${SERVER_KEY}" \\\n\
  -user-resources="${ENABLE_USER_RESOURCES:-true}" \\\n\
  -silent=false\n\
' > start.sh && chmod +x start.sh

CMD ["./start.sh"]