# ServerStatus 环境变量示例文件
# 使用说明：复制为 .env 并填写真实值；docker-compose 会读取此文件。

# --- 核心密钥（必填，务必改成强随机值）---
PROJECT_KEY=public
SERVER_KEY=serverstatus.ltd

# --- 服务端口 ---
# 数据服务端口；docker-compose 会将宿主机 ${SERVER_PORT} 映射到容器 8080
SERVER_PORT=8080
# 演示前端端口（如不使用内置 demo 可忽略）
FRONTEND_PORT=8081

# --- 数据/日志/导出目录 ---
# 可改成绝对路径以持久化挂载
DATA_DIR=./data
LOG_DIR=./data-server/logs
EXPORTS_DIR=./data-server/exports

# --- Agent 默认上报配置 ---
# docker 网络中访问 data-server 的地址；非 compose 部署请改成实际服务地址
SERVER_URL=http://data-server:8080/api/data
# Agent 注册/上报时使用的主机名
AGENT_HOSTNAME=serverstatus-agent
# 是否上报“用户维度”资源占用（进程按用户名聚合，含命令行等可能敏感信息）
# 需要最小开销或避免敏感信息时设为 false；需查看多用户资源分布时设为 true
ENABLE_USER_RESOURCES=false

# --- GitHub OAuth 登录 ---
# 在 GitHub Developer Settings 创建 OAuth App 后填写
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
# 可留空，后端会按 host/port 推导；若自定义域名/反代请显式配置完整 URL
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# --- 可选：覆盖后端其他配置（无需求可留空）---
# DB_PATH=./data/serverstatus.db
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# LOG_LEVEL=info
# LOG_FILE=./logs/serverstatus.log
